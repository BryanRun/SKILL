# Runtime bind address.
TELEMETRY_HOST=0.0.0.0
TELEMETRY_PORT=18080

# Admin token for /metrics and manual /telemetry/flush calls.
TELEMETRY_ADMIN_TOKEN=change-me-admin-token

# Versioned HMAC keys used by gerrit-pipeline telemetry clients.
# Keep all 2.0.x keys enabled so every 2.0.x client can continue reporting.
TELEMETRY_HMAC_KEYS={"gerrit-pipeline-v2.0.0":"change-me-2-0-x-legacy-hmac-secret","gerrit-pipeline-v2.0.1":"change-me-2-0-x-legacy-hmac-secret","gerrit-pipeline-v2.0.2":"change-me-2-0-x-legacy-hmac-secret","gerrit-pipeline-v2.0.3":"change-me-2-0-3-hmac-secret"}
TELEMETRY_REVOKED_KEY_IDS=
TELEMETRY_SIGNATURE_MAX_AGE_SECONDS=300
TELEMETRY_NONCE_TTL_SECONDS=600

# Local queue database. Relative paths are resolved from the process cwd.
TELEMETRY_DB_PATH=./data/telemetry.sqlite3

# Set true for local API testing without writing Feishu Bitable.
TELEMETRY_DRY_RUN=false

# Flush behavior.
TELEMETRY_FLUSH_INTERVAL_SECONDS=30
TELEMETRY_FLUSH_BATCH_SIZE=50
TELEMETRY_MAX_ATTEMPTS=20
TELEMETRY_IN_FLIGHT_TIMEOUT_SECONDS=300
TELEMETRY_HTTP_TIMEOUT_SECONDS=10
TELEMETRY_MAX_BODY_BYTES=65536

# Only these skill names are accepted.
TELEMETRY_SKILL_ALLOWLIST=gerrit-pipeline

# Feishu Open Platform app credentials.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Feishu Bitable target.
FEISHU_BITABLE_APP_TOKEN=bascnxxx
FEISHU_BITABLE_TABLE_ID=tblxxx

# Optional JSON map merged over defaults: event field -> Bitable field name.
# TELEMETRY_FIELD_MAP={"submitter_name":"提交人","skill_version":"版本"}
